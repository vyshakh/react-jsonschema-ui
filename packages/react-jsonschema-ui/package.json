{
  "name": "react-jsonschema-ui",
  "version": "0.2.0",
  "description": "Universal JSON Schema form renderer for React Native and React (web): Tamagui widgets, Zustand state, Ajv validation.",
  "keywords": [
    "json-schema",
    "form",
    "react",
    "react-native",
    "expo",
    "tamagui",
    "zustand",
    "ajv",
    "jsonschema-form",
    "universal"
  ],
  "author": "Vyshakh <parakkat.vyshakh@gmail.com>",
  "license": "MIT",
  "homepage": "https://vyshakh.github.io/react-jsonschema-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vyshakh/react-jsonschema-ui.git",
    "directory": "packages/react-jsonschema-ui"
  },
  "bugs": {
    "url": "https://github.com/vyshakh/react-jsonschema-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "@react-jsonschema-ui/source": "./src/index.ts",
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "@react-jsonschema-ui/source": "./src/core.ts",
      "react-native": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "cp ../../README.md ../../LICENSE . && pnpm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "tamagui": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "tamagui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tamagui/config": "3.1.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.3.1",
    "react-native-web": "0.21.3",
    "tamagui": "3.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
